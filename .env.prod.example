# Entorno de producción. Sirve para probar la imagen en local con valores de prod:
# copia este archivo a .env.prod (que no se sube a git).
# En Azure estas variables se configuran como App Settings de la Web App, no con este archivo.
# Los secretos van en Key Vault, nunca aquí.

# Puerto en el que escucha el servidor (lo leen `fastapi dev` y `fastapi run`)
PORT=80

APP_ENV=prod
APP_LOG_LEVEL=INFO
APP_DOCS_ENABLED=false

# Autenticación con Entra (ninguno es secreto). Vacío = la API rechaza todos los tokens.
# issuer y jwks_uri: copiar del .well-known/openid-configuration de cada tenant.
# audience: client ID de la app registration de la API en ese tenant.
# Clientes (tenant externo, Entra External ID)
APP_AUTH_CUSTOMERS_ISSUER=
APP_AUTH_CUSTOMERS_JWKS_URI=
APP_AUTH_CUSTOMERS_AUDIENCE=
# Staff (tenant workforce, Entra ID)
APP_AUTH_STAFF_ISSUER=
APP_AUTH_STAFF_JWKS_URI=
APP_AUTH_STAFF_AUDIENCE=

# Azure SQL (sin contraseña: la Web App se autentica con su managed identity).
# Solo funciona dentro de Azure: la base es privada y en tu PC no hay managed identity,
# así que al probar esta imagen en local verás "Database connection FAILED" en los logs.
APP_DB_SERVER=dp3-mssql-orders-server.database.windows.net
APP_DB_NAME=dp3-mssql-orders
APP_DB_AUTHENTICATION=ActiveDirectoryMSI
