# Entorno de desarrollo. Copia este archivo a .env.dev (que no se sube a git).
# Nunca pongas secretos en los .example.

# Puerto en el que escucha el servidor (lo leen `fastapi dev` y `fastapi run`)
PORT=8080

APP_ENV=dev
APP_LOG_LEVEL=DEBUG
APP_DOCS_ENABLED=true

# Autenticación con Entra External ID (ninguno es secreto). Vacío = la API rechaza todos los tokens.
# issuer y jwks_uri: copiar del .well-known/openid-configuration del tenant externo.
# audience: client ID de la app registration de la API.
APP_AUTH_ISSUER=
APP_AUTH_JWKS_URI=
APP_AUTH_AUDIENCE=

# Azure SQL. Vacío = la app arranca sin base de datos y usa repositorios en memoria.
# En local se deja vacío: la base usa Always Encrypted y la llave solo la abre la managed
# identity de la Web App, que no existe en tu PC.
APP_DB_SERVER=
APP_DB_NAME=
